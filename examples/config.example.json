{
    "input_dir": "./vtt",
    "output_dir": "./vtt/zh",
    "done_dir": "./vtt/done",
    "log_dir": "./logs",

    "provider": "bedrock",
    "model_id": "global.anthropic.claude-opus-4-6-v1",
    "aws_region": "us-west-2",
    "max_tokens": 4096,
    "temperature": 0.3,
    "proxy_url": null,
    "verify_proxy_on_startup": true,

    "source_language": "en",
    "target_language": "zh",
    "glossary_file": null,

    "chunk_size": 50,
    "context_window": 5,

    "max_retries": 5,
    "retry_base_delay": 2.0,
    "retry_max_delay": 60.0,
    "api_sleep_time": 2.0,

    "min_sleep_time": 180,
    "max_sleep_time": 300,

    "fallback_to_source": true,
    "fallback_marker": "",

    "max_concurrent_files": 1,
    "max_concurrent_chunks": 3,
    "enable_resume": true
}
